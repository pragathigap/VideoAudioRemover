<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ensure HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^index\.html$ - [L]

  # Allow direct access to assets and ffmpeg folder
  RewriteCond %{REQUEST_URI} ^/assets/ [NC]
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_URI} ^/ffmpeg/ [NC]
  RewriteRule ^ - [L]

  # SPA Routing: If the file or directory doesn't exist, serve index.html
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Required for SharedArrayBuffer (FFmpeg.wasm)
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Cross-Origin-Embedder-Policy "credentialless"

  # Caching for static assets
  <FilesMatch "\.(js|mjs|css|png|jpg|jpeg|gif|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Prevent caching of index.html to ensure users get the latest version
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </Files>
</IfModule>
